# Docker ignore file for mmengine-lite
# Excludes files that should not be copied into the Docker image

# Training outputs
work_dirs/
outputs/

# Checkpoints (large files)
checkpoints/
*.pth
*.pt
*.ckpt

# Data directories (should be mounted as volumes)
data/

# Visualization outputs
vis_output/
visualizations/

# Python cache
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg

# Virtual environments
venv/
ENV/
env/
.venv/

# IDE and editor files
.idea/
.vscode/
*.swp
*.swo
*~
.project
.pydevproject
.settings/

# Jupyter
.ipynb_checkpoints/
*.ipynb

# Git
.git/
.gitignore
.gitattributes

# Documentation (optional, uncomment if not needed in image)
# docs/
# *.md

# Testing
.pytest_cache/
.coverage
htmlcov/
.tox/
.nox/

# Logs
*.log
logs/

# OS files
.DS_Store
Thumbs.db

# Temporary files
tmp/
temp/
*.tmp
*.temp

# Docker files (no need to include in image)
docker/
Dockerfile
docker-compose.yml
.dockerignore

# CI/CD
.github/
.gitlab-ci.yml
.travis.yml

# Misc
*.bak
*.orig
